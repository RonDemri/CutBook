@{
    ViewData["Title"] = "My Incomes";
    Layout = "~/Views/Shared/MasterPage.cshtml";
}
<link href="~/css/stylesheetmyincomes.css" rel="stylesheet" />
<div class="admin-container">
    <h2 class="admin-title">📊 Financial Overview</h2>
    <div class="income-cards-container">
        <div class="income-card monthly">
            <h3>Monthly Income</h3>
            <p class="income-amount">₪@ViewBag.MonthlyIncome</p>
        </div>
        <div class="income-card yearly">
            <h3>Yearly Income</h3>
            <p class="income-amount">₪@ViewBag.YearlyIncome</p>
        </div>
    </div>
</div>